FROM joynext-lg-tools:mu0883
RUN apt-get update && apt-get install -y --no-install-recommends weston \
    && rm -rf /var/lib/apt/lists/*
RUN apt-get update && apt-get install -y --no-install-recommends openjdk-17-jdk-headless \
    && rm -rf /var/lib/apt/lists/*
COPY mock_commgr.c /src/mock_commgr.c
RUN gcc -static -O2 -Wall -Wextra -Werror /src/mock_commgr.c -o /mock_commgr \
    && /mock_commgr --self-test
